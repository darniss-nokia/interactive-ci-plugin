<!--
  Dedicated per-build Interactive Output page (reached from the run's left-sidebar link and the
  experimental tab bar). l:run-subpage keeps the experimental build chrome.
-->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <l:run-subpage>
    <st:include page="content.jelly"/>
  </l:run-subpage>
</j:jelly>

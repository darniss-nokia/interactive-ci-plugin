<!--
  The interactive-view review editor page (reached from the run's left-sidebar "Interactive View" link,
  the experimental tab bar, the anchored console link, and the notification bell). viewer.js reads the
  ?doc=<id> query parameter. l:run-subpage keeps the experimental build chrome.
-->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <l:run-subpage>
    <st:include page="content.jelly"/>
  </l:run-subpage>
</j:jelly>

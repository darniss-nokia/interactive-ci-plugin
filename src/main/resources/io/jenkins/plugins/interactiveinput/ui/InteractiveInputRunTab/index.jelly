<!--
  Full Interactive Input tab page for the experimental run UI. Core's l:run-subpage keeps the build
  title, tabs and actions; the audit widget is the same fragment the classic sidepanel action uses.
-->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <l:run-subpage>
    <st:include page="content.jelly" it="${it.inputAction}"/>
  </l:run-subpage>
</j:jelly>

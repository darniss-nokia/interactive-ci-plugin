<!--
  Per-build audit view (reached from the build's left-sidebar link, the experimental tab bar, and the
  anchored console link). l:run-subpage keeps the experimental build chrome so a tab click and a
  sidebar click land on the same page.
-->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <l:run-subpage>
    <st:include page="content.jelly"/>
  </l:run-subpage>
</j:jelly>

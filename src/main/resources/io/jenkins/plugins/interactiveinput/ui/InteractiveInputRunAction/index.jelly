<!--
  Per-build audit view (reached from the build's left-sidebar link and the anchored console link).
  The shared JS widget fetches this build's questions (including settled ones, with the recorded
  answer) and renders what was asked (prompt + context + choices) and what was chosen (answer + who).
-->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <l:layout title="Interactive Input - ${it.run.fullDisplayName}">
    <l:side-panel>
      <st:include it="${it.run}" page="sidepanel.jelly" optional="true"/>
    </l:side-panel>
    <l:main-panel>
      <h1>Interactive Input</h1>
      <p class="ii-page-sub">Audit of human-in-the-loop questions for
        <strong>${it.run.fullDisplayName}</strong>.</p>
      <div class="interactive-input-widget"
           data-ii-audit="build"
           data-root-url="${rootURL}"
           data-job="${it.jobFullName}"
           data-build="${it.buildNumber}"
           data-scope="build"
           data-poll-seconds="${it.pollingIntervalSeconds}"
           data-rich-modal="${it.richModalEnabled}"/>
      <st:adjunct includes="io.jenkins.plugins.interactiveinput.bell"/>
    </l:main-panel>
  </l:layout>
</j:jelly>

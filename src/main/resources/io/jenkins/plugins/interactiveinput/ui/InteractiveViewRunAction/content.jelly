<!--
  Shared review-editor body. Used by index.jelly (classic sidepanel) and by
  InteractiveViewRunTab/index.jelly (l:run-subpage). viewer.js reads ?doc=<id>.
-->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler">
  <st:adjunct includes="io.jenkins.plugins.prism"/>
  <st:adjunct includes="io.jenkins.plugins.interactiveinput.viewer"/>
  <div class="iv-app"
       data-iv-root="true"
       data-root-url="${rootURL}"
       data-job="${it.jobFullName}"
       data-build="${it.buildNumber}"
       data-poll-seconds="${it.pollingIntervalSeconds}">
    <div class="iv-loading">Loading review&#8230;</div>
  </div>
</j:jelly>

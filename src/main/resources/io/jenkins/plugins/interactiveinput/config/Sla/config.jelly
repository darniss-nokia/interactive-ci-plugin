<!--
  Default SLA, rendered under Manage Jenkins -> System -> "Interactive Input" via
  <f:property field="sla"/> (B20: previously configurable only via JCasC/Script Console). Applies only
  when an askInteractive invocation does not set its own slaMinutes; 0 means no SLA (waits forever).
-->
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="Default SLA (minutes)" field="defaultMinutes">
    <f:number default="0" min="0" step="1"/>
    <f:description>
      Minutes before an unanswered question expires, used when a step does not set its own slaMinutes.
      0 disables the SLA (the question waits indefinitely).
    </f:description>
  </f:entry>
</j:jelly>

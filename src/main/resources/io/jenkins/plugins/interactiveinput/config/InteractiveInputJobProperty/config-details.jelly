<!--
  Outbound notify-only channels (email / Microsoft Teams / Slack). Each channel is its own
  ExtensionPoint implementation with its own config. Nothing here answers a question.
-->
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="Channels"
           description="Notify-only. Email uses Jenkins Mailer SMTP (including Microsoft 365 when SMTP is configured there). Slack and Teams use a Secret-text credential holding the incoming-webhook URL. Recipients can include addresses that cannot open the job — same model as the Mailer publisher.">
    <f:hetero-list name="channels"
                   items="${instance.channels}"
                   descriptors="${descriptor.channelDescriptors}"
                   addCaption="Add notification channel"
                   hasHeader="true"/>
  </f:entry>
</j:jelly>
